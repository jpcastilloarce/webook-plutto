{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/upload",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/text",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/files",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/files/(.*)",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/health",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/docs",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
